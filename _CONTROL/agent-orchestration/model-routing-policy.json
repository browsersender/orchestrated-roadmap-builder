{
  "schemaVersion": 1,
  "policyId": "sola-model-tier-routing-v2",
  "workerSafety": {
    "minimumCDriveFreeGb": 15,
    "lowDiskPolicy": "warn_unless_explicitly_authorized",
    "explicitUserOverrideAllowed": true,
    "maximumBriefWords": 1500,
    "maximumReturnWords": 300,
    "forkContext": false,
    "childWorkersAllowed": false
  },
  "lanes": {
    "SOL_OWNED": { "model": "gpt-5.6-sol", "reasoningEffort": "xhigh" },
    "TERRA_PRIMARY": { "model": "gpt-5.6-terra", "reasoningEffort": "xhigh" },
    "LUNA_BOUNDED": { "model": "gpt-5.6-luna", "reasoningEffort": "high" },
    "TERRA_LUNA_FANOUT": { "model": "gpt-5.6-terra", "reasoningEffort": "xhigh", "fanoutModel": "gpt-5.6-luna", "fanoutReasoningEffort": "high" },
    "CLAUDE_OPUS48_SPECIALIST": { "model": "claude-opus-4-8", "reasoningEffort": "xhigh", "interface": "claude-cli" },
    "CLAUDE_OPUS5_SPECIALIST": { "model": "claude-opus-5", "reasoningEffort": "xhigh", "interface": "claude-cli" },
    "CLAUDE_SONNET5_PRIMARY": { "model": "claude-sonnet-5", "reasoningEffort": "xhigh", "interface": "claude-cli" },
    "CLAUDE_HAIKU45_BOUNDED": { "model": "claude-haiku-4-5-20251001", "reasoningEffort": "high", "interface": "claude-cli" },
    "HUMAN_AUTHORITY": { "model": null, "reasoningEffort": null }
  },
  "laneTiers": {
    "SOL_OWNED": "coordinator",
    "TERRA_PRIMARY": "primary",
    "LUNA_BOUNDED": "bounded",
    "TERRA_LUNA_FANOUT": "fanout",
    "CLAUDE_OPUS48_SPECIALIST": "specialist",
    "CLAUDE_OPUS5_SPECIALIST": "specialist",
    "CLAUDE_SONNET5_PRIMARY": "primary",
    "CLAUDE_HAIKU45_BOUNDED": "bounded",
    "HUMAN_AUTHORITY": "human"
  }
}
