{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sola.worker-result.v1",
  "type": "object",
  "required": ["schemaVersion", "taskId", "status", "model", "changedPaths", "checks", "blockers", "integrationNote"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "blocked", "failed"] },
    "model": { "enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "claude-opus-4-8"] },
    "changedPaths": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "object", "required": ["command", "result"], "properties": { "command": { "type": "string" }, "result": { "enum": ["pass", "fail", "not_run"] } } } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "integrationNote": { "type": "string" },
    "commit": { "type": ["string", "null"] }
  }
}
