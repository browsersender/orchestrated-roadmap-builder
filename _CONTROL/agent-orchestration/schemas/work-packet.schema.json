{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sola.work-packet.v1",
  "type": "object",
  "required": ["schemaVersion", "taskId", "objective", "briefPath", "taskProfile", "inputs", "ownedOutputs", "prohibitedPaths", "constraints", "acceptanceChecks", "returnContract"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "briefPath": { "type": "string", "minLength": 3 },
    "taskProfile": {
      "type": "object",
      "required": ["ambiguity", "blastRadius", "crossProduct", "behaviorChange", "mechanicalAcceptance", "authorityRequired", "filesExpected"],
      "properties": {
        "ambiguity": { "enum": ["low", "medium", "high"] },
        "blastRadius": { "enum": ["low", "medium", "high"] },
        "crossProduct": { "type": "boolean" },
        "behaviorChange": { "type": "boolean" },
        "mechanicalAcceptance": { "type": "boolean" },
        "authorityRequired": { "type": "boolean" },
        "filesExpected": { "type": "integer", "minimum": 1 },
        "taskShape": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "ownedOutputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "prohibitedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": {
      "type": "object",
      "required": ["forkContext", "childWorkersAllowed", "maximumBriefWords", "maximumReturnWords"],
      "properties": {
        "forkContext": { "const": false },
        "childWorkersAllowed": { "const": false },
        "maximumBriefWords": { "type": "integer", "maximum": 1500 },
        "maximumReturnWords": { "type": "integer", "maximum": 300 }
      }
    },
    "acceptanceChecks": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "returnContract": { "type": "string", "minLength": 1 }
  }
}
