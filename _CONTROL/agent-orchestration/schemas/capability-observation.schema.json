{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sola.capability-observation.v1",
  "type": "object",
  "required": ["schemaVersion", "observationId", "taskId", "model", "taskShape", "observed", "review", "verdict"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "model": { "enum": ["gpt-5.6-terra", "gpt-5.6-luna", "claude-opus-4-8", "claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5-20251001"] },
    "taskShape": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "observed": {
      "type": "object",
      "required": ["briefWords", "returnWords", "elapsedSeconds", "changedFiles", "insertions", "deletions", "correctionRounds", "outOfScopeEdits"],
      "properties": {
        "briefWords": { "type": "integer", "minimum": 0 },
        "returnWords": { "type": "integer", "minimum": 0 },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "changedFiles": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "correctionRounds": { "type": "integer", "minimum": 0 },
        "outOfScopeEdits": { "type": "integer", "minimum": 0 }
      }
    },
    "review": {
      "type": "object",
      "required": ["contractFidelity", "boundaryDiscipline", "sourceUnderstanding", "refusalIntegrity", "testQuality", "evidenceHonesty", "implementationQuality"],
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
    },
    "verdict": { "enum": ["retain_lane", "narrow_lane", "reroute_to_terra", "reroute_to_sol", "reject_result"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
